---
// 4 pasos (BUILD §3): escribes → pagas → videollamada → informe.
import Icon from './Icon.astro';
import type { Ui } from '../data/types';
interface Props { ui: Ui; title?: boolean }
const { ui, title = true } = Astro.props;
const icons = ['chat', 'card', 'video', 'doc'] as const;
---
<section class="py-12" aria-labelledby="pasos">
  {title && <h2 id="pasos" class="mb-6 text-2xl sm:text-3xl">{ui.stepsTitle}</h2>}
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {ui.steps.map((s, i) => (
      <li class="card">
        <span class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-brand-soft text-brand"><Icon name={icons[i]} size={22} /></span>
        <p class="mb-1 text-sm font-semibold text-brand">{i + 1}</p>
        <h3 class="mb-1 font-sans text-lg font-bold">{s.title}</h3>
        <p class="text-[15px] text-muted">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
