---
// Medición (BUILD §6). Solo PageView y el clic a WhatsApp, llamada o pago. NUNCA se envía la enfermedad, la URL de
// la landing como parámetro ni datos de formularios. Cada script se carga solo si su ID está lleno (TODO en site.ts).
// En /fr/ (UE/Quebec) Meta y TikTok esperan a que la persona acepte el banner de cookies (Cookie.astro).
import { site, filled } from '../data/site';
import type { Lang } from '../data/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cfg = {
  ga4: filled(site.GA4_ID) ? site.GA4_ID : '',
  aw: filled(site.AW_ID) ? site.AW_ID : '',
  label: filled(site.CONTACT_LABEL) ? site.CONTACT_LABEL : '',
  meta: filled(site.META_PIXEL_ID) ? site.META_PIXEL_ID : '',
  tiktok: filled(site.TIKTOK_PIXEL_ID) ? site.TIKTOK_PIXEL_ID : '',
  clarity: filled(site.CLARITY_ID) ? site.CLARITY_ID : '',
  pay: filled(site.PAY_LINK_USD50) ? site.PAY_LINK_USD50 : '',
  needsConsent: lang === 'fr',
};
const gtagSrc = cfg.ga4 || cfg.aw ? `https://www.googletagmanager.com/gtag/js?id=${cfg.ga4 || cfg.aw}` : '';
---
{gtagSrc && <script is:inline async src={gtagSrc}></script>}
<script is:inline define:vars={{ cfg }}>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;
if(cfg.needsConsent){gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});}
gtag('js',new Date());
if(cfg.ga4)gtag('config',cfg.ga4);
if(cfg.aw)gtag('config',cfg.aw);

// Meta y TikTok: una sola carga por página (bandera __poAds). En FR, solo tras «Aceptar».
window.poLoadAds=function(){
  if(window.__poAds)return;window.__poAds=1;
  if(cfg.meta){
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init',cfg.meta);fbq('track','PageView');
  }
  if(cfg.tiktok){
    !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=d.createElement("script");o.type="text/javascript";o.async=!0;o.src=i+"?sdkid="+e+"&lib="+t;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};
    ttq.load(cfg.tiktok);ttq.page();
    }(window,document,'ttq');
  }
};
var consent=null;try{consent=localStorage.getItem('po-consent');}catch(e){}
if(!cfg.needsConsent)window.poLoadAds();
else if(consent==='yes'){gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});window.poLoadAds();}

// Microsoft Clarity (enmascara los campos por defecto; esta web no tiene formularios).
if(cfg.clarity&&(!cfg.needsConsent||consent==='yes')){(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",cfg.clarity);}

// Clic a WhatsApp, llamada o link de pago: evento sin parámetros + apertura a los 300 ms.
window.trackContact=function(){
  if(window.gtag&&cfg.aw&&cfg.label)gtag('event','conversion',{send_to:cfg.aw+'/'+cfg.label});
  if(window.gtag&&cfg.ga4)gtag('event','click_contacto');
  if(window.fbq)fbq('track','Lead');
  if(window.ttq&&window.ttq.track)ttq.track('Contact');
};
document.addEventListener('click',function(e){
  var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;
  var h=a.getAttribute('href')||'';
  var isPay=cfg.pay&&h.indexOf(cfg.pay)===0;
  if(!/wa\.me|whatsapp|^tel:/i.test(h)&&!isPay)return;
  e.preventDefault();window.trackContact();
  setTimeout(function(){
    if(a.target==='_blank'&&!/^tel:/i.test(h))window.open(a.href,'_blank','noopener');
    else window.location.href=a.href;
  },300);
});
</script>
