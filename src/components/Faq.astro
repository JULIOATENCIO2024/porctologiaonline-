---
import type { Faq } from '../data/types';
interface Props { faqs: Faq[]; title: string }
const { faqs, title } = Astro.props;
---
<section class="py-10" aria-labelledby="faq">
  <h2 id="faq" class="mb-5 text-2xl sm:text-3xl">{title}</h2>
  <div class="divide-y divide-brand-line rounded-2xl border border-brand-line bg-white">
    {faqs.map((f) => (
      <details class="group p-5">
        <summary class="flex items-start justify-between gap-4 font-semibold"><span>{f.q}</span><span aria-hidden="true" class="text-xl leading-none text-brand transition group-open:rotate-45">+</span></summary>
        <p class="mt-3 text-muted" set:html={f.a} />
      </details>
    ))}
  </div>
</section>
