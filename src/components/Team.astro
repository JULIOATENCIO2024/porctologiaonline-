---
// Fichas de los médicos con CMP/RNE visibles (BUILD §8.5). Datos vacíos = TODO del cliente: no se muestran.
import { doctorById, attending, docName, filled, type Doctor } from '../data/site';
import type { Lang } from '../data/types';
interface Props { lang: Lang; title: string; ids?: string[]; compact?: boolean }
const { lang, title, ids = attending[lang], compact = false } = Astro.props;
const docs = ids.map(doctorById);
const role = (d: Doctor) => {
  const fem = d.name.startsWith('Dra.');
  if (!filled(d.rne) && filled(d.cmp)) return { es: 'Médica del equipo de proctología', en: 'Physician, proctology team', fr: 'Médecin de l’équipe de proctologie' }[lang];
  return { es: fem ? 'Proctóloga' : 'Proctólogo', en: 'Proctologist (colorectal specialist)', fr: 'Proctologue' }[lang];
};
const verify = { es: 'Verifica la colegiatura en', en: 'Verify the license at', fr: 'Vérifiez l’inscription sur' }[lang];
---
<section class="py-10" aria-labelledby="equipo-t">
  <h2 id="equipo-t" class="mb-5 text-2xl sm:text-3xl">{title}</h2>
  <ul class={`grid gap-4 ${compact || docs.length === 1 ? 'sm:grid-cols-1 max-w-xl' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
    {docs.map((d) => (
      <li class="card flex items-center gap-4">
        {d.photo
          ? <img src={d.photo} alt={docName(d, lang)} width="88" height="88" loading="lazy" decoding="async" class="h-22 w-22 shrink-0 rounded-full bg-brand-soft object-cover object-top" />
          : <span aria-hidden="true" class="flex h-22 w-22 shrink-0 items-center justify-center rounded-full bg-brand-soft font-serif text-3xl text-brand">{docName(d, lang).replace(/^(Dra?\.|Dre|Dr)\s*/, '')[0]}</span>}
        <div>
          <p class="font-serif text-lg font-semibold leading-snug">{docName(d, lang)}</p>
          <p class="text-[15px] text-muted">{role(d)}</p>
          {(filled(d.cmp) || filled(d.rne)) && (
            <p class="mt-1 text-sm font-semibold text-brand-dark">{filled(d.cmp) && `CMP ${d.cmp}`}{filled(d.rne) && ` · RNE ${d.rne}`}</p>
          )}
        </div>
      </li>
    ))}
  </ul>
  <p class="mt-3 text-sm text-muted">{verify} <a href="https://www.cmp.org.pe/conoce-a-tu-medico/" target="_blank" rel="noopener">Colegio Médico del Perú</a>.</p>
</section>
