---
// Logo en texto mientras llega el archivo (BUILD §2): «Proctología Online» + «by Clínica Proctológica Lima».
import { prefix } from '../lib/routes';
import type { Lang } from '../data/types';
interface Props { lang: Lang; link?: boolean }
const { lang, link = true } = Astro.props;
const Tag = link ? 'a' : 'div';
---
<Tag {...(link ? { href: prefix(lang) } : {})} class="flex shrink-0 items-center gap-2.5 text-ink no-underline">
  <svg width="38" height="38" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="20" fill="#1E6E25"/><path d="M11 22.5c2.6 4.6 7.3 6.5 12 5.1M20 11.5a7 7 0 1 1-6.6 9.4" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/><circle cx="27.5" cy="12.5" r="3" fill="#BFE3B9"/></svg>
  <span class="leading-tight">
    <span class="block font-serif text-[19px] font-semibold">Proctología <span class="text-brand">Online</span></span>
    <span class="block text-[11.5px] font-semibold text-muted">by Clínica Proctológica Lima</span>
  </span>
</Tag>
