# proctologiaonline.com — SiteGround (Apache)
ErrorDocument 404 /404.html
Options -Indexes
DirectorySlash On

RewriteEngine On
# HTTPS y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://proctologiaonline.com/$1 [L,R=301]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|webp|avif|png|jpg|ico|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
  # Landings de pauta: fuera del índice también por cabecera
  <If "%{REQUEST_URI} =~ m#^/((en|fr)/)?lp/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/xml image/svg+xml
</IfModule>
